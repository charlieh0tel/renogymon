# Configuration for renogymon-archiver-puller (archive host side)

# rsync source. Format: <pi-ssh-user>@<pi-tailscale-name>:<path-relative-to-rrsync-root>
# The Pi's key is rrsync-scoped to the staging dir, so the path is "./".
#ARCHIVER_REMOTE=renogymon-archiver@rpi4-tailscale-name:./

# Where to land the Parquet corpus on this host.
ARCHIVER_DEST=/var/lib/renogy-archive

# SSH private key (lives only on this host).
ARCHIVER_SSH_KEY=/var/lib/renogymon-archiver-puller/id_ed25519

# Freshness check (renogymon-archiver-check.timer, hourly).  Mails ALERT_EMAIL
# via /usr/sbin/sendmail when the set of problems changes: once when something
# goes stale and once when it recovers.
#ALERT_EMAIL=root
#CHECK_MAX_ARCHIVE_AGE_DAYS=3

# VictoriaMetrics on the Pi; setting it enables the live-data check.
#CHECK_VM_URL=http://rpi4-tailscale-name:8428
#CHECK_MAX_LIVE_AGE_MINUTES=15
